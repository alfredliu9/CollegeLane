{
  // Local-only Wrangler config. This is NOT a deploy config and is NOT read by
  // the dev server -- `vite.config.ts` owns the bindings the Cloudflare Vite
  // plugin injects into `npm run dev`.
  //
  // It exists so the Wrangler CLI can apply the `drizzle/` migrations to the
  // same Miniflare D1 database that `npm run dev` uses:
  //
  //   npm run db:migrate
  //
  // The filename is intentionally non-standard so the Vite plugin does not
  // auto-detect it and end up with two competing sources of binding config.
  "name": "collegelane-local",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "site-creator-d1",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "site-creator-r2"
    }
  ]
}
